{
  "name": "ridesync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src",
    "preview": "vite preview --host 0.0.0.0",
    "test:db:local": "node scripts/test-db-local.mjs",
    "check:edge": "deno check --config supabase/functions/deno.json supabase/functions/calculate-route/index.ts supabase/functions/search-places/index.ts supabase/functions/trip-voice/index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "livekit-client": "^2.23.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "deno": "^2.9.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "livekit-server-sdk": "^2.19.2",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
