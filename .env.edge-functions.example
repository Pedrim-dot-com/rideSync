# Server only. Configure remote secrets separately; never prefix these with VITE_.
ROUTING_API_KEY=
# ROUTING_API_KEY is also used for geocoding.
# HTTPS origins only, comma-separated. No trailing slash.
APP_ORIGINS=
AI_API_KEY=

# LiveKit Cloud: server only; set these in Supabase Edge Function secrets.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
